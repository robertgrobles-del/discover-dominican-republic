# Public browser configuration only. Any VITE_* value is shipped to users.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=
VITE_STRAPI_URL=

# Data source for the frontend: "mock" (default) or "api".
# "api" is reserved until backend writes are connected (plan A10 #21/#92):
# that build excludes the bundled mock and fails closed at startup.
VITE_DATA_SOURCE=mock

# Un build de producción (vite build, modo production) con datos simulados está bloqueado: define
# VITE_DATA_SOURCE=api para un despliegue real, o activa esta variable solo para una demo deliberada.
VITE_ALLOW_MOCK_BUILD=false

# Never add SUPABASE_SERVICE_ROLE_KEY, private API tokens, or signing secrets here.

# Sesión: "mock" (demostración) o "api" (inicio de sesión real contra el backend). Vacío: sigue a VITE_DATA_SOURCE.
# Con VITE_AUTH_SOURCE=api y VITE_DATA_SOURCE=mock se prueba la consola, el estudio de creadores y los paneles que
# ya usan la API con una cuenta real, mientras el catálogo sigue saliendo de los datos simulados.
# Requiere VITE_API_URL (p. ej. http://localhost:3000/api/v1) y que el backend liste este origen en CORS_ORIGINS.
VITE_AUTH_SOURCE=


# Catálogo público: "static" (archivos locales) o "api" (backend por el mismo origen, /api/v1). Vacío sigue a
# VITE_DATA_SOURCE: un despliegue real lee el catálogo del backend sin configurarlo aparte.
# Con "api" el catálogo (playas, alojamientos, restaurantes, montañas, ríos, recetas, aeropuertos, artículos…) sale
# del backend en el idioma activo; si no responde, se muestran los archivos locales. No sirve con VITE_API_URL en
# otro dominio: la política de seguridad lo bloquea.
VITE_CATALOG_SOURCE=
