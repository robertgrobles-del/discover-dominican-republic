{
  "kind": "collectionType",
  "collectionName": "playas",
  "info": {
    "singularName": "playa",
    "pluralName": "playas",
    "displayName": "Playa & Río / Balneario",
    "description": "Playas paradisíacas, costas, ríos y cascadas de RD"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "categoria": {
      "type": "enumeration",
      "enum": ["playa-mar", "rio-balneario", "cascada-salto", "cenote-cueva-agua"],
      "default": "playa-mar"
    },
    "descripcion": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descripcionLarga": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tipoArena": {
      "type": "enumeration",
      "enum": ["blanca", "dorada", "negra", "grano-fino", "guijarros-rocas"]
    },
    "nivelOleaje": {
      "type": "enumeration",
      "enum": ["piscina-natural-calma", "tranquilo", "moderado", "fuerte-olas", "surf-windsurf"]
    },
    "tipoAgua": {
      "type": "enumeration",
      "enum": ["turquesa-cristalina", "azul-profundo", "verde-esmeralda", "agua-dulce-fria"]
    },
    "acceso": {
      "type": "enumeration",
      "enum": ["vehiculo-asfaltado", "4x4-todo-terreno", "barco-lancha", "sendero-caminata"]
    },
    "precioEntrada": {
      "type": "string",
      "default": "Acceso Público Gratuito",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "facilidades": {
      "type": "json",
      "description": "Restaurantes, alquiler de sombrillas, baños, duchas, parqueo vigilado, salvavidas Politur"
    },
    "seguridadRecomendaciones": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "latitud": {
      "type": "float"
    },
    "longitud": {
      "type": "float"
    },
    "imagenPrincipal": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "galeria": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "destino": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::destino.destino",
      "inversedBy": "playas"
    }
  }
}
