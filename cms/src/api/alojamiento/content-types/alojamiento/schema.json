{
  "kind": "collectionType",
  "collectionName": "alojamientos",
  "info": {
    "singularName": "alojamiento",
    "pluralName": "alojamientos",
    "displayName": "Alojamiento & Hospedaje",
    "description": "Resorts todo incluido, hoteles boutique, eco-lodges y villas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "categoria": {
      "type": "enumeration",
      "enum": [
        "resort-all-inclusive",
        "hotel-boutique",
        "eco-lodge-montana",
        "villa-lujo",
        "apartahotel-familiar",
        "glamping-playa",
        "hostal-backpackers",
        "hotel-historico-colonial"
      ],
      "required": true
    },
    "estrellas": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "rangoPrecio": {
      "type": "enumeration",
      "enum": ["economico", "moderado", "premium", "ultra-lujo"],
      "default": "moderado"
    },
    "precioDesdeUSD": {
      "type": "decimal"
    },
    "descripcion": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descripcionDetallada": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "amenidades": {
      "type": "json",
      "description": "Array de amenidades: piscina infinity, spa, acceso directo playa, golf, wifi 5g, todo incluido bebidas premium, pet friendly"
    },
    "checkIn": {
      "type": "string",
      "default": "15:00"
    },
    "checkOut": {
      "type": "string",
      "default": "12:00"
    },
    "telefono": {
      "type": "string"
    },
    "emailReservas": {
      "type": "string"
    },
    "sitioWebOficial": {
      "type": "string"
    },
    "enlaceReservaDirecto": {
      "type": "string"
    },
    "latitud": {
      "type": "float"
    },
    "longitud": {
      "type": "float"
    },
    "imagenes": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "destino": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::destino.destino",
      "inversedBy": "alojamientos"
    }
  }
}
