{
  "kind": "collectionType",
  "collectionName": "articulos",
  "info": {
    "singularName": "articulo",
    "pluralName": "articulos",
    "displayName": "Sala de Prensa & Comunicados",
    "description": "Noticias turísticas, comunicados y novedades de MITUR"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "categoria": {
      "type": "enumeration",
      "enum": [
        "noticia-institucional",
        "turismo-sostenible",
        "inversion-confotur",
        "eventos-festivales",
        "estadisticas-llegadas"
      ],
      "default": "noticia-institucional"
    },
    "resumen": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contenido": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "fechaPublicacion": {
      "type": "date",
      "required": true
    },
    "portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "fuente": {
      "type": "string",
      "default": "Ministerio de Turismo (MITUR)"
    }
  }
}
