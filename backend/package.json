{
  "name": "descubre-rd-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST v1 de Descubre RD (Fastify + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:embedded": "tsx scripts/dev-db.ts",
    "db:gen-baseline": "tsx scripts/gen-baseline.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-from-mock.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts --reset && tsx --env-file-if-exists=.env scripts/seed-from-mock.ts",
    "db:gen-manifest": "tsx --env-file-if-exists=.env scripts/gen-manifest.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/uuid": "^10.0.0",
    "autocannon": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "mailparser": "^3.9.28",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
