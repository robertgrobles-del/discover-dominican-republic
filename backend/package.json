{
  "name": "descubre-rd-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST v1 de Descubre RD (Fastify + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project integration",
    "test:unit": "vitest run --project unit --reporter=verbose",
    "test:all": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "db:embedded": "tsx scripts/dev-db.ts",
    "db:gen-baseline": "tsx scripts/gen-baseline.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:check-migrations": "tsx --env-file-if-exists=.env scripts/check-migrations.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-from-mock.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "db:seed-bulk": "tsx scripts/seed-bulk.ts",
    "db:purge-synthetic": "tsx --env-file-if-exists=.env scripts/purge-synthetic.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts --reset",
    "docs:api": "tsx --env-file-if-exists=.env scripts/gen-api-doc.ts",
    "docs:openapi": "tsx scripts/generate-openapi.ts",
    "docs:capabilities": "tsx scripts/gen-capability-doc.ts",
    "db:import-static": "tsx --env-file-if-exists=.env scripts/import-static.ts",
    "db:gen-manifest": "tsx --env-file-if-exists=.env scripts/gen-manifest.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "loadtest": "tsx --env-file-if-exists=.env scripts/loadtest.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "db:explain": "tsx --env-file-if-exists=.env scripts/explain.ts",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:links": "tsx --env-file-if-exists=.env scripts/check-links.ts",
    "architecture:dependencies": "node scripts/audit-module-dependencies.mjs --max-pairs=0",
    "architecture:tables": "node scripts/audit-table-access.mjs --max-shared=41 --max-shared-writes=0",
    "weather:reconcile": "node services/weather/scripts/reconcile-snapshots.mjs",
    "weather:reconcile:apply": "node services/weather/scripts/reconcile-snapshots.mjs --apply",
    "weather:reconcile:replace": "node services/weather/scripts/reconcile-snapshots.mjs --apply --replace",
    "weather:reconcile:verify": "node services/weather/scripts/reconcile-snapshots.mjs --verify",
    "weather:migrate": "node --env-file-if-exists=.env services/weather/scripts/migrate.mjs",
    "weather:migrate:check": "node --env-file-if-exists=.env services/weather/scripts/migrate.mjs --check",
    "weather:build": "tsc -p services/weather/tsconfig.json",
    "weather:dev": "tsx watch --env-file-if-exists=.env services/weather/server.ts",
    "weather:start": "node --env-file-if-exists=.env dist-weather/services/weather/server.js",
    "content:build": "tsc -p services/content/tsconfig.json",
    "content:dev": "tsx watch --env-file-if-exists=.env services/content/server.ts",
    "content:start": "node --env-file-if-exists=.env dist-content/services/content/server.js",
    "content:tables": "tsx scripts/gen-content-tables.ts",
    "content:tables:check": "tsx scripts/gen-content-tables.ts --check"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "openapi-types": "^12.1.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/autocannon": "^7.12.7",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "autocannon": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "mailparser": "^3.9.28",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
