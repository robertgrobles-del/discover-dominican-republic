# Copia este archivo a .env (no se versiona). Ver src/config/env.ts para todas las variables y sus valores por defecto.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Docker Compose (puerto 5433) o PostgreSQL embebido de `npm run db:embedded` (puerto 5434)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/descubre_rd
DB_POOL_MAX=10

# Orígenes del portal y paneles (separados por comas)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Proxies de confianza para X-Forwarded-For: false (por defecto: no se acepta la cabecera) | nº de saltos | lista de IP/CIDR.
# En producción "true" se rechaza al arrancar: sólo se confía en proxys conocidos.
# TRUST_PROXY=false

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# En producción la documentación (/docs y /openapi.json) queda apagada salvo que se active explícitamente
DOCS_ENABLED=true
PUBLIC_BASE_URL=http://localhost:3000

# Autenticación. En desarrollo se genera un par de claves efímero si faltan; en producción son obligatorias (RS256, PEM con saltos de línea escritos como \n).
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_ENABLED=true
WEB_BASE_URL=http://localhost:8080

# Correo: log (imprime el mensaje en el log) | smtp (Mailpit de docker-compose en 1025, SES, etc.)
# En producción sólo se admite smtp: log y memory no entregan correo real.
MAIL_TRANSPORT=log
MAIL_FROM="Descubre RD <no-reply@descubre.local>"
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Administrador de desarrollo que crea `npm run db:seed` (nunca en producción)
# SEED_ADMIN_EMAIL=admin@descubre.local
# SEED_ADMIN_PASSWORD=Admin-Descubre-2026!

# Tasa USD→DOP de respaldo mientras no haya tasas en la tabla exchange_rates
DEFAULT_USD_DOP=59.8

# Banderas de funciones expuestas en GET /api/v1/config
FEATURE_CHECKOUT=false
FEATURE_AI_CHAT=false
FEATURE_OPERATORS=true
FEATURE_STORE=true

# Para las pruebas (opcional; por defecto usa la base embebida en el puerto 5434)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/descubre_rd_test

# ---- Seguridad adicional ----
# Cola de correo (el trabajador corre en este proceso; ponlo en false si lo ejecutas aparte)
MAIL_WORKER_ENABLED=true
MAIL_POLL_MS=2000
MAIL_MAX_ATTEMPTS=5

# Límites de tasa: memory (una instancia) | postgres (varias instancias) | redis (requiere REDIS_URL)
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://localhost:6380

# Rotación de claves JWT: claves públicas anteriores (arreglo JSON de PEM, con \n)
# JWT_PREVIOUS_PUBLIC_KEYS=["-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"]

# 2FA: clave AES-256 en base64 (openssl rand -base64 32). Obligatoria en producción.
# TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Descubre RD
# Exige 2FA a admin/editor/moderator (por defecto: true en producción, false en desarrollo)
# REQUIRE_2FA_FOR_STAFF=true

# Login con Google (OIDC). Redirección autorizada: {PUBLIC_BASE_URL}/api/v1/auth/oauth/google/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# Destinos extra permitidos tras el login social (además de WEB_BASE_URL y CORS_ORIGINS)
# OAUTH_REDIRECT_ALLOWLIST=

# Pasarela de pago: fake (dev/pruebas) | none (producción hasta integrar un proveedor)
# PAYMENT_PROVIDER=fake

# Trabajos programados de Operadores RD (recordatorios, reseñas, calendarios). Desactívalo en instancias que no deban ejecutarlos.
# JOBS_ENABLED=true

# Pasarelas dominicanas (PAYMENT_PROVIDER=azul | cardnet): integración PRELIMINAR, escrita sin acceso al sandbox.
# Antes de usarlas hay que validar campos y respuestas con el adquirente; en producción exigen PAYMENT_LOCAL_GATEWAY_VALIDATED=true.
# AZUL_BASE_URL=https://pruebas.azul.com.do/webservices/JSON/Default.aspx
# AZUL_MERCHANT_ID=
# AZUL_AUTH1=
# AZUL_AUTH2=
# AZUL_CERT_PATH=/run/secrets/azul.crt
# AZUL_KEY_PATH=/run/secrets/azul.key
# CARDNET_BASE_URL=https://lab.cardnet.com.do/servicios/tokens/v1
# CARDNET_PRIVATE_KEY=
# PAYMENT_LOCAL_GATEWAY_VALIDATED=false
# Stripe (PAYMENT_PROVIDER=stripe): clave secreta y secreto del webhook (whsec_...)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Secreto para enlaces firmados sin estado (baja de newsletter). Obligatorio en producción, mínimo 32 caracteres.
# APP_SECRET=

# Datos vivos: none (sin llamadas externas) | open_er_api (tasas) | openweather (clima; requiere OPENWEATHER_API_KEY)
# FX_PROVIDER=none
# FX_SPREAD_PCT=1
# WEATHER_PROVIDER=none
# OPENWEATHER_API_KEY=
# Proxy optativo al proceso weather tras aplicar su migración y desplegarlo.
# Debe coincidir con WEATHER_SERVICE_TOKEN del proceso weather (secreto aleatorio >=32 caracteres).
# WEATHER_SERVICE_URL=http://localhost:3001
# WEATHER_SERVICE_TOKEN=
# Congela CRUD y refresh del facade durante la reconciliación final; desactívalo al activar el proxy hacia weather.
# WEATHER_WRITES_FROZEN=false
# El servicio weather y sus migraciones requieren su conexión PostgreSQL propia:
# WEATHER_DATABASE_URL=postgres://weather:change-me@localhost:5435/descubre_weather
# Configuración sólo para el proceso weather. Al activar proxy + refresh, no registres el scheduler weather del monolito.
# WEATHER_PROVIDER=none
# WEATHER_REFRESH_ENABLED=false
# WEATHER_REFRESH_INTERVAL_SECONDS=1800
# Lecturas de catálogo por HTTP hacia el proceso content (optativo). Debe coincidir con su CONTENT_SERVICE_TOKEN (>=32 caracteres).
# Sin estas dos variables el facade lee el catálogo de su propia base.
# CONTENT_SERVICE_URL=http://localhost:3002
# CONTENT_SERVICE_TOKEN=
# El servicio content usa su conexión PostgreSQL propia (proyección de lectura; ver services/content/scripts/sync-projection.sh):
# CONTENT_DATABASE_URL=postgres://content:change-me@localhost:5438/descubre_content
# Origen de la proyección visto desde el contenedor content-sync (por omisión, el servicio `postgres` de Compose):
# CONTENT_SOURCE_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5434/descubre_rd
# Si el origen es el PostgreSQL embebido (v18), usa la misma versión mayor en destino y herramienta:
# CONTENT_PG_IMAGE=postgres:18-alpine
