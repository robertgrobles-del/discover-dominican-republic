# Copia este archivo como .env.prod o .env.staging en el VPS (nunca al repositorio) y completa los valores.

# Dominios. En staging: staging.descubrerd.com y api-staging.descubrerd.com (o el que se defina).
SITE_DOMAIN=descubrerd.com
API_DOMAIN=api.descubrerd.com
ACME_EMAIL=

# Carpeta del VPS con las versiones del frontend (releases/<versión> y el enlace `current`).
SITE_ROOT=/srv/descubre/site

# Base de datos. Genera la clave con: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Secretos de la API (ver docs/BACKEND_OPERACION.md para generarlos y rotarlos).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
APP_SECRET=
TOTP_ENCRYPTION_KEY=

# Correo. Obligatorio: la API no arranca en producción sin un servidor SMTP (también en staging).
MAIL_FROM=Descubre RD <no-reply@descubrerd.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Pagos: none hasta contratar una pasarela.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Imagen de la API. Vacío = se construye en el VPS desde ../backend.
API_IMAGE=

# Staging en el mismo VPS que producción: usa puertos distintos (por ejemplo 8080 y 8443).
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# Monitoreo (opcional). SENTRY_DSN: el del proyecto de Sentry (Settings → Client Keys). ALERT_WEBHOOK_URL: un
# webhook entrante de Slack o de Discord; lo usan la API (errores no controlados y caída del proceso),
# backup.sh (respaldo fallido) y watchdog.sh (la API no responde).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
ALERT_WEBHOOK_URL=

# Respaldos (deploy/backup.sh)
BACKUP_DIR=/srv/descubre/backups
BACKUP_KEEP_DAYS=14
# Copia externa cifrada. Con BACKUP_S3_BUCKET vacío el respaldo sólo queda en este servidor.
# Vale cualquier almacenamiento compatible con S3: AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2,
# MinIO o Google Cloud Storage (con claves HMAC y BACKUP_S3_ENDPOINT=https://storage.googleapis.com).
# Usa una clave que sólo pueda escribir en ese bucket, y una regla de ciclo de vida para caducar las copias.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
# Vacío = AWS S3 de esa región.
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=backups/
# Clave de cifrado (24 caracteres o más): openssl rand -base64 32. Guárdala FUERA del servidor (gestor de
# contraseñas): sin ella las copias no se pueden leer, y quien la tenga junto al bucket puede leerlas todas.
BACKUP_ENCRYPTION_KEY=
