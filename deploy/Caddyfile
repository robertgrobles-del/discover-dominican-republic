# Entrada única del VPS: certificados TLS automáticos, sitio estático y proxy hacia la API.
{
	email {$ACME_EMAIL}
}

(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(api) {
	reverse_proxy api:3000 {
		# Durante el reinicio de la API en un despliegue, reintenta en vez de devolver 502.
		lb_try_duration 30s
		lb_try_interval 500ms
		health_uri /health/ready
		health_interval 10s
	}
}

{$SITE_DOMAIN} {
	import seguridad
	encode zstd gzip

	# El sitio llama a la API por su mismo origen (/api/v1): su política de seguridad de contenido sólo
	# permite conexiones a 'self', y así la cookie de sesión es del mismo sitio y no hace falta CORS.
	handle /api/* {
		import api
	}

	handle {
		root * /srv/site/current
		# Los archivos con hash no cambian nunca; index.html se revalida siempre para tomar la versión nueva.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		# Las fichas prerenderizadas (`scripts/postbuild.mjs`) viven en <ruta>/index.html: se sirven antes de caer en
		# la plantilla de la aplicación, sin redirigir a la barra final.
		# Toda ruta sin extensión es una página (prerenderizada o de la aplicación): se revalida siempre.
		@pagina not path *.*
		header @pagina Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

# Mismo backend en su propio dominio, para integraciones externas (webhooks de pago, clientes B2B).
{$API_DOMAIN} {
	import seguridad
	encode zstd gzip
	import api
}
